  "items": [
    {
      "number": 1,
      "id": "q01",
      "text": "Людям не следует выражать свои эмоции открыто.",
      "required": true,
      "scale": "ECV_VALUE",
      "direction": "direct"
    },
    {
      "number": 2,
      "id": "q02",
      "text": "Сильные эмоции очень трудно контролировать.",
      "required": true,
      "scale": "ECV_EFFICACY",
      "direction": "reverse"
    },
    {
      "number": 3,
      "id": "q03",
      "text": "По людям обычно видно, что они чувствуют.",
      "required": true,
      "direction": "direct",
      "control": true
    },
    {
      "number": 4,
      "id": "q04",
      "text": "Это неправильно – всегда показывать свои чувства.",
      "required": true,
      "scale": "ECV_VALUE",
      "direction": "direct"
    },
    {
      "number": 5,
      "id": "q05",
      "text": "Можно многому научиться, но нельзя научиться управлять своими эмоциями.",
      "required": true,
      "scale": "ECV_EFFICACY",
      "direction": "reverse"
    },
    {
      "number": 6,
      "id": "q06",
      "text": "Людям не следует сдерживать свои эмоции.",
      "required": true,
      "scale": "ECV_VALUE",
      "direction": "reverse"
    },
    {
      "number": 7,
      "id": "q07",
      "text": "Каждый может научиться управлять своими эмоциями.",
      "required": true,
      "scale": "ECV_EFFICACY",
      "direction": "direct"
    },
    {
      "number": 8,
      "id": "q08",
      "text": "Люди почти всегда контролируют свои эмоциональные реакции.",
      "required": true,
      "direction": "direct",
      "control": true
    },
    {
      "number": 9,
      "id": "q09",
      "text": "Чтобы справиться с сильными эмоциями, нужно дать им выход.",
      "required": true,
      "scale": "ECV_VALUE",
      "direction": "reverse"
    },
    {
      "number": 10,
      "id": "q10",
      "text": "Если человек захочет, он всегда может изменить свое эмоциональное состояние.",
      "required": true,
      "scale": "ECV_EFFICACY",
      "direction": "direct"
    },
    {
      "number": 11,
      "id": "q11",
      "text": "Людям следует лучше контролировать свои эмоции.",
      "required": true,
      "scale": "ECV_VALUE",
      "direction": "direct"
    },
    {
      "number": 12,
      "id": "q12",
      "text": "Как бы человек ни старался, он не может изменить свое эмоциональное состояние.",
      "required": true,
      "scale": "ECV_EFFICACY",
      "direction": "reverse"
    },
    {
      "number": 13,
      "id": "q13",
      "text": "Вполне допустимо выражать свои эмоции – и отрицательные, и положительные.",
      "required": true,
      "scale": "ECV_VALUE",
      "direction": "reverse"
    },
    {
      "number": 14,
      "id": "q14",
      "text": "На самом деле эмоции почти не поддаются контролю.",
      "required": true,
      "scale": "ECV_EFFICACY",
      "direction": "reverse"
    },
    {
      "number": 15,
      "id": "q15",
      "text": "Большинство людей не контролируют свои эмоции должным образом.",
      "required": true,
      "direction": "direct",
      "control": true
    }
  ],
