    {
      "id": "q01",
      "ordinal": 1,
      "kind": "single_choice",
      "options": [
        {
          "value": "A",
          "label": "Иногда я предоставляю возможность другим взять на себя ответственность за решение проблемы."
        },
        {
          "value": "B",
          "label": "Я пытаюсь подчеркнуть те стороны проблемы, по которым мы согласны друг с другом, а не обсуждать вопросы, по которым у нас согласия нет."
        }
      ]
    },
    {
      "id": "q02",
      "ordinal": 2,
      "kind": "single_choice",
      "options": [
        {
          "value": "A",
          "label": "Я пытаюсь найти компромиссное решение."
        },
        {
          "value": "B",
          "label": "Я пытаюсь заниматься как своими проблемами, так и проблемами партнера."
        }
      ]
    },
    {
      "id": "q03",
      "ordinal": 3,
      "kind": "single_choice",
      "options": [
